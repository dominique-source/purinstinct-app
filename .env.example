# ── Firebase (Vite exige le préfixe VITE_) ──────────────────────
# Console Firebase > Paramètres du projet > Tes applications > Config
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# ── PINs d'accès (plus jamais dans le code source) ──────────────
# VITE_MODE_PIN retiré: remplacé par les codes VITE_CODE_* + resolveMode
# (étape 2 du multi-mode). ADMIN_PIN reste le raccourci "tout débloqué",
# STATION_PIN gate le rôle admin/station à l'intérieur du flux Live.
VITE_ADMIN_PIN=1111
VITE_STATION_PIN=2222

# ── Codes d'entrée multi-mode (src/config/modes.js) ──────────────
# Un code à 4 chiffres par mode (même pavé que les PINs ci-dessus) →
# resolveMode(code) mappe vers la clé de mode.
# Le code ADMIN_PIN ci-dessus reste le raccourci caché "tout débloqué".
VITE_CODE_GAMES=0000
VITE_CODE_CORPORATE=0001
VITE_CODE_ECOLE=0002
VITE_CODE_FESTIVAL=0003
VITE_CODE_PARC=0004

# ── Envoi automatique du code de pré-inscription (api/send-claim-code.js) ──
# RESEND_API_KEY et RESEND_FROM: variables SERVEUR (jamais VITE_, jamais
# exposées au client) — à définir dans Vercel > Settings > Environment
# Variables. Créer un compte sur resend.com, générer une clé API.
# RESEND_FROM peut rester "PurInstinct Games <onboarding@resend.dev>"
# (domaine de test Resend, fonctionne sans configuration DNS) ou une adresse
# sur un domaine vérifié dans Resend une fois prêt.
RESEND_API_KEY=
RESEND_FROM=PurInstinct Games <onboarding@resend.dev>

# INTERNAL_API_SECRET (serveur) + VITE_INTERNAL_API_SECRET (même valeur,
# côté client) — friction minimale pour éviter qu'un lien /api/send-claim-code
# trouvé au hasard ne soit utilisé pour spammer via notre compte Resend.
# Pas un vrai secret (visible dans le bundle client), juste un filtre basique.
INTERNAL_API_SECRET=
VITE_INTERNAL_API_SECRET=
